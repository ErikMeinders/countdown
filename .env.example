# Copy to .env.local (git-ignored) and fill in your deployed backend URL.
#
#   cd backend && export AWS_PROFILE=my-profile && make deploy
#   printf 'VITE_COUNTDOWN_WEBSOCKET_URL=%s\n' "$(cd backend && make -s websocket-url)" > .env.local
#
# Leave it unset to run local single-player only — "Play together" is then
# disabled with an explanation, and the app still works fully offline.
VITE_COUNTDOWN_WEBSOCKET_URL=wss://your-api-id.execute-api.eu-west-1.amazonaws.com/dev
